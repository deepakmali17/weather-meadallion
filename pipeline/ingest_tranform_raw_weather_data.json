{
	"name": "ingest_tranform_raw_weather_data",
	"properties": {
		"activities": [
			{
				"name": "get cityies list",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "adls_json_config_DS",
						"type": "DatasetReference",
						"parameters": {
							"storagepath": {
								"value": "@pipeline().parameters.storagepath",
								"type": "Expression"
							}
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "get cityies list",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('get cityies list').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy data1",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "JsonSource",
									"storeSettings": {
										"type": "HttpReadSettings",
										"requestMethod": "GET"
									},
									"formatSettings": {
										"type": "JsonReadSettings"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "https_json_DS",
									"type": "DatasetReference",
									"parameters": {
										"latitude": {
											"value": "@item().latitude",
											"type": "Expression"
										},
										"longitude": {
											"value": "@item().longitude",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "adls_json_DS",
									"type": "DatasetReference",
									"parameters": {
										"city": {
											"value": "@item().city",
											"type": "Expression"
										},
										"storagepath": {
											"value": "@pipeline().parameters.storagepath",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Notebook1",
							"type": "DatabricksNotebook",
							"dependsOn": [
								{
									"activity": "Copy data1",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": "/Shared/weather-meadallion/notebooks/01_bronze_ingest",
								"baseParameters": {
									"cityName": {
										"value": "@item().city",
										"type": "Expression"
									},
									"fileName": {
										"value": "@concat('weather_data_',formatDateTime(utcNow(), 'yyyy_MM_dd'),'.json')",
										"type": "Expression"
									},
									"raw_path": {
										"value": "@pipeline().parameters.raw_path",
										"type": "Expression"
									},
									"bronze_table": {
										"value": "@pipeline().parameters.bronze_table",
										"type": "Expression"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "AzureDatabricks_LS",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			},
			{
				"name": "silver_layer",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "ForEach1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Shared/weather-meadallion/notebooks/02_silver_transform",
					"baseParameters": {
						"raw_path": {
							"value": "@pipeline().parameters.raw_path",
							"type": "Expression"
						},
						"silver_table": {
							"value": "@pipeline().parameters.silver_table",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "AzureDatabricks_LS",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "gold_summary",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "silver_layer",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Shared/weather-meadallion/notebooks/03_gold_aggregate",
					"baseParameters": {
						"raw_path": {
							"value": "@pipeline().parameters.raw_path",
							"type": "Expression"
						},
						"gold_table": {
							"value": "@pipeline().parameters.gold_table",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "AzureDatabricks_LS",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"raw_path": {
				"type": "string"
			},
			"bronze_table": {
				"type": "string"
			},
			"silver_table": {
				"type": "string"
			},
			"gold_table": {
				"type": "string"
			},
			"storagepath": {
				"type": "string"
			}
		},
		"annotations": []
	}
}