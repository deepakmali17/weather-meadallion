				"type": "string"
			},
			"storagepath": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Json",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@concat('weather_data_',formatDateTime(utcNow(), 'yyyy_MM_dd'),'.json')",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat('raw/',dataset().city)",
					"type": "Expression"
				},
				"fileSystem": "weather"
			}
		},
		"schema": {}
	}
}